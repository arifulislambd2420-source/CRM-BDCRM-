# Copy to `.env` and fill in real values. Never commit `.env`.

# ---- Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Auth
# Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_dev_secret_do_not_use_in_production
JWT_REFRESH_SECRET=change_me_refresh_secret_also_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Database (Prisma / MySQL)
#
# Local dev (passwordless root MySQL on this machine):
#   mysql://root@127.0.0.1:3306/crm
#
# Local dev with a password:
#   mysql://root:yourPassword@127.0.0.1:3306/crm
#
# Hostinger's managed MySQL — same URL shape; grab the host/user/password/db
# from Hostinger's control panel (Databases → Manage → MySQL details).
# Add `?ssl_ca_path=...` or `?ssl-mode=REQUIRED` if Hostinger enforces TLS.
#   mysql://<user>:<pass>@<host>:3306/<db>
# Local dev:   mysql://root@127.0.0.1:3306/crm
# Hostinger:   mysql://u818052381_bdcrm:PASS@HOSTINGER_HOST:3306/u818052381_crm
DATABASE_URL=mysql://root@127.0.0.1:3306/crm

# On first boot with an empty DB (0 users), seed demo data.
# Set to "false" once you have real users so a redeploy never re-seeds.
SEED_ON_EMPTY=true
