# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it's in .gitignore.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Auth
# Use `openssl rand -hex 32` or `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
# to generate a secret. Do NOT ship the demo value below to production.
JWT_SECRET=change_me_dev_secret_do_not_use_in_production
JWT_EXPIRES_IN=7d

# Database
# SQLite file path; created on first boot if it doesn't exist.
DB_PATH=./data/crm.db

# On first run, seed the DB from data/seed.ts. Set to "false" after your first
# real users/data exist so a redeploy doesn't try to re-seed.
SEED_ON_EMPTY=true
