// Prisma schema for the CRM.
// Switching from local MySQL to Hostinger's managed MySQL is DATABASE_URL only —
// no changes here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  sub_admin
  store_manager
}

enum OrderStatus {
  pending
  confirmed
  cancelled
}

enum IntegrationAccountType {
  whatsapp
  messenger
}

model User {
  id              String   @id
  name            String
  email           String   @unique
  passwordHash    String   @map("password_hash")
  role            Role
  storeId         String?  @map("store_id")
  canEditOwnNotes Boolean  @default(false) @map("can_edit_own_notes")

  store            Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdCustomers Customer[]      @relation("CustomerCreator")
  authoredNotes    Note[]          @relation("NoteAuthor")
  refreshTokens    RefreshToken[]
  createdOrders    Order[]         @relation("OrderCreator")
  recordedPayments Payment[]       @relation("PaymentRecorder")
  recordedExpenses Expense[]       @relation("ExpenseRecorder")

  @@index([storeId])
  @@map("users")
}

model Store {
  id        String     @id
  name      String
  managers  User[]
  customers Customer[]

  @@map("stores")
}

model Pipeline {
  id        String     @id
  name      String
  stages    Stage[]
  customers Customer[]

  @@map("pipelines")
}

model Stage {
  id         String   @id
  pipelineId String   @map("pipeline_id")
  name       String
  sortIndex  Int      @map("sort_index")

  pipeline         Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  customersOnStage Customer[] @relation("CurrentStage")

  @@index([pipelineId, sortIndex])
  @@map("stages")
}

model Customer {
  id             String   @id
  name           String
  phone          String
  address        String   @default("")
  source         String   @default("")
  pipelineId     String   @map("pipeline_id")
  currentStageId String   @map("current_stage_id")
  storeId        String   @map("store_id")
  createdAt      DateTime @map("created_at")
  createdById    String   @map("created_by_id")

  // Channel identity — populated when a conversation arrives via webhook.
  // Never overwrite existing attribution (first-touch wins).
  whatsappWaId          String?  @unique @map("whatsapp_wa_id")
  messengerPsid         String?  @map("messenger_psid")
  messengerPageId       String?  @map("messenger_page_id")
  ctwaClid              String?  @map("ctwa_clid")       // click-to-WhatsApp ad click id
  firstContactChannel   String?  @map("first_contact_channel")
  firstContactAt        DateTime? @map("first_contact_at")

  pipeline     Pipeline @relation(fields: [pipelineId], references: [id])
  currentStage Stage    @relation("CurrentStage", fields: [currentStageId], references: [id])
  store        Store    @relation(fields: [storeId], references: [id])
  createdBy    User     @relation("CustomerCreator", fields: [createdById], references: [id])
  notes        Note[]
  orders       Order[]

  @@index([storeId])
  @@index([pipelineId])
  @@index([currentStageId])
  @@map("customers")
}

model Note {
  id            String   @id
  customerId    String   @map("customer_id")
  number        Int
  text          String   @db.Text
  createdAt     DateTime @map("created_at")
  createdById   String   @map("created_by_id")
  createdByName String   @map("created_by_name")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation("NoteAuthor", fields: [createdById], references: [id])

  // Sequential per customer, never recycled. Enforced in code via max(number)+1.
  @@unique([customerId, number], map: "notes_customer_number_unique")
  @@index([customerId, number])
  @@map("notes")
}

model Setting {
  key   String @id
  value String @db.Text

  @@map("settings")
}

model Product {
  id            String   @id
  name          String
  description   String?  @db.Text
  price         Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  imagePath     String?  @map("image_path")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model Order {
  id                   String      @id
  customerId           String      @map("customer_id")
  status               OrderStatus @default(pending)
  totalOriginalAmount  Decimal     @map("total_original_amount") @db.Decimal(12, 2)
  totalDiscountedAmount Decimal    @map("total_discounted_amount") @db.Decimal(12, 2)
  totalPaid            Decimal     @default(0) @map("total_paid") @db.Decimal(12, 2)
  totalDue             Decimal     @map("total_due") @db.Decimal(12, 2)
  notes                String?     @db.Text
  createdById          String      @map("created_by_id")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  customer       Customer        @relation(fields: [customerId], references: [id])
  createdBy      User            @relation("OrderCreator", fields: [createdById], references: [id])
  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String  @id
  orderId             String  @map("order_id")
  productId           String  @map("product_id")
  quantity            Int
  unitOriginalPrice   Decimal @map("unit_original_price") @db.Decimal(12, 2)
  unitDiscountedPrice Decimal @map("unit_discounted_price") @db.Decimal(12, 2)
  lineTotal           Decimal @map("line_total") @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            String   @id
  orderId       String   @map("order_id")
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @map("payment_date")
  paymentMethod String   @map("payment_method")
  note          String?  @db.Text
  recordedById  String   @map("recorded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User  @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([orderId])
  @@map("payments")
}

model StockMovement {
  id        String   @id
  productId String   @map("product_id")
  orderId   String?  @map("order_id")
  change    Int      // negative = deduction, positive = addition
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderId])
  @@map("stock_movements")
}

model Expense {
  id           String   @id
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  description  String?  @db.Text
  expenseDate  DateTime @map("expense_date")
  recordedById String   @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  recordedBy User @relation("ExpenseRecorder", fields: [recordedById], references: [id])

  @@index([expenseDate])
  @@map("expenses")
}

// Multi-account Meta integration. Each row = one WhatsApp number or Facebook Page.
// Conversations/ChannelIdentities reference integration_account_id so adding a
// second account later is a data-entry task, not a code change.
model IntegrationAccount {
  id          String                 @id
  accountType IntegrationAccountType @map("account_type")
  label       String                 // admin-chosen name
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  // WhatsApp-specific (null for Messenger)
  wabaId        String? @map("waba_id")
  phoneNumberId String? @map("phone_number_id")

  // Messenger-specific (null for WhatsApp)
  pageId String? @map("page_id")

  // Shared credential fields (stored encrypted in future; plaintext for now)
  appId            String? @map("app_id")
  appSecret        String? @map("app_secret") @db.Text
  accessToken      String? @map("access_token") @db.Text
  webhookVerifyToken String? @map("webhook_verify_token")

  @@map("integration_accounts")
}

/**
 * Refresh tokens are stored server-side so we can revoke individual sessions
 * (logout on one device, admin-forced logout, etc.). The token *string* is
 * hashed at rest; the raw value only leaves the server once when issued.
 */
model RefreshToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
