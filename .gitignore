# Workspace-root defaults; each subproject also has its own .gitignore.

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local config (per-session)
.claude/

# Node / build outputs (also covered per-subproject)
node_modules/
dist/
*.log

# Env files with secrets
.env
.env.local
server/uploads/
